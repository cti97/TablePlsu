<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TablePlsu.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Settings\defaults.json" LogicalName="TablePlsu.Core.Settings.defaults.json" />
    <EmbeddedResource Include="Settings\settings.schema.json" LogicalName="TablePlsu.Core.Settings.settings.schema.json" />
    <EmbeddedResource Include="Themes\light.json" LogicalName="TablePlsu.Core.Themes.light.json" />
    <EmbeddedResource Include="Themes\dark.json" LogicalName="TablePlsu.Core.Themes.dark.json" />
    <EmbeddedResource Include="Themes\nord.json" LogicalName="TablePlsu.Core.Themes.nord.json" />
    <EmbeddedResource Include="Themes\solarized-light.json" LogicalName="TablePlsu.Core.Themes.solarized-light.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TablePlsu.Tests" />
  </ItemGroup>

</Project>
