<Window x:Class="TablePlsu.App.Features.Palette.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pal="clr-namespace:TablePlsu.App.Features.Palette"
        Title="Open Anything" Width="640" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource c.app.border}"
            Background="{DynamicResource c.app.window}" TextElement.Foreground="{DynamicResource c.app.windowForeground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="8,6"
                         AutomationProperties.Name="Palette search" />
                <TextBlock x:Name="Hint" Text="{Binding Placeholder}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           FontSize="14" Foreground="{DynamicResource c.app.mutedForeground}" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ListBox x:Name="List" Grid.Row="1" Margin="0,8,0,0" MaxHeight="420" ItemsSource="{Binding Rows}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewMouseLeftButtonUp="OnListClick" AutomationProperties.Name="Palette results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c.app.hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c.app.sidebarSelection}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type pal:PaletteRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{DynamicResource Icon}" FontSize="13" Text="{Binding Icon}" Foreground="{DynamicResource c.app.accent}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Foreground="{DynamicResource c.app.mutedForeground}" />
                            <TextBlock Grid.Column="3" Text="{Binding Shortcut}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource c.app.mutedForeground}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Status" Grid.Row="2" Text="{Binding StatusText}" Margin="8,8,8,2" Foreground="{DynamicResource c.app.mutedForeground}" />
        </Grid>
    </Border>
</Window>
