<UserControl x:Class="TablePlsu.App.Features.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:TablePlsu.App.Infrastructure"
             xmlns:ws="clr-namespace:TablePlsu.App.Features.Workspace"
             xmlns:conn="clr-namespace:TablePlsu.Core.Connections;assembly=TablePlsu.Core"
             infra:CommandScopes.Scope="Workspace"
             Background="{DynamicResource c.app.window}">
    <UserControl.Resources>
        <!-- Toolbar item templates (DataContext = WorkspaceViewModel). Factories in WorkspaceFeature reference them as "tb.<id>". -->
        <DataTemplate x:Key="tb.toggleSidebar">
            <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}"
                          ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[sidebar.toggle]}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE700;" />
            </ToggleButton>
        </DataTemplate>

        <DataTemplate x:Key="tb.connection">
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunCommand}" CommandParameter="palette.openConnection"
                    ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[palette.openConnection]}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE703;" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="tb.changes">
            <Border BorderBrush="{DynamicResource c.app.border}" BorderThickness="1" CornerRadius="4" Margin="4,0" Height="28">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="Discard" Command="{Binding RunCommand}" CommandParameter="changes.discard"
                            IsEnabled="{Binding ActiveTab.HasPendingChanges, FallbackValue=False}"
                            ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[changes.discard]}" />
                    <Border Width="1" Background="{DynamicResource c.app.border}" />
                    <Button Style="{StaticResource FlatButton}" Content="Preview" Command="{Binding RunCommand}" CommandParameter="changes.preview"
                            IsEnabled="{Binding ActiveTab.HasPendingChanges, FallbackValue=False}"
                            ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[changes.preview]}" />
                    <Border Width="1" Background="{DynamicResource c.app.border}" />
                    <Button Style="{StaticResource FlatButton}" Content="Commit" Command="{Binding RunCommand}" CommandParameter="changes.commit"
                            IsEnabled="{Binding ActiveTab.HasPendingChanges, FallbackValue=False}"
                            ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[changes.commit]}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="tb.safeMode">
            <Button Style="{StaticResource ToolbarButton}" Click="OnSafeModeClick" ToolTip="Safe Mode">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SafeModeText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="tb.database">
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunCommand}" CommandParameter="palette.openDatabase"
                    ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[palette.openDatabase]}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE1D3;" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Database}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="tb.newSql">
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunCommand}" CommandParameter="editor.new"
                    ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[editor.new]}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,6,0" />
                    <TextBlock Text="SQL" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="tb.status">
            <Grid Margin="6,0">
                <Button Command="{Binding ToggleStatusPopupCommand}" Focusable="False" Height="28" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border CornerRadius="5" Background="{DynamicResource c.app.statusBar}" />
                                <Border CornerRadius="5" Background="{Binding StatusBrush}" />
                                <Border x:Name="Hover" CornerRadius="5" Background="#18FFFFFF" Opacity="0" />
                                <ContentPresenter Margin="10,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="TextElement.Foreground" Value="{Binding StatusForeground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusForeground}" Value="{x:Null}">
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource c.app.statusBarForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource c.app.mutedForeground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Connected">
                                            <Setter Property="Fill" Value="{DynamicResource c.app.success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Connecting">
                                            <Setter Property="Fill" Value="{DynamicResource c.app.warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Broken">
                                            <Setter Property="Fill" Value="{DynamicResource c.app.error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360">
                            <Run Text="{Binding Profile.DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" / " /><Run Text="{Binding Database, Mode=OneWay}" />
                        </TextBlock>
                        <Border Grid.Column="2" Style="{StaticResource TagPill}" Margin="8,0,0,0" Background="{Binding TagBrush, TargetNullValue=Gray}"
                                Visibility="{Binding Tag, Converter={x:Static infra:NullToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding Tag}" />
                        </Border>
                        <TextBlock Grid.Column="3" AutomationProperties.AutomationId="ConnectionStatus" Text="{Binding StatusText}" Opacity="0.8" Margin="10,0,0,0" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Grid.Column="4" Width="70" Height="4" Margin="10,0,0,0" IsIndeterminate="{Binding IsBusy}"
                                     Visibility="{Binding IsBusy, Converter={x:Static infra:BoolToVisibilityConverter.Instance}}"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource c.app.accent}" />
                    </Grid>
                </Button>
                <Popup IsOpen="{Binding IsStatusPopupOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
                       VerticalOffset="4" PopupAnimation="None">
                    <Border Style="{StaticResource PopoverBorder}" MinWidth="320">
                        <StackPanel>
                            <TextBlock Text="{Binding Profile.DisplayName}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,2,14,2" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Text="Server" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                                <TextBlock Grid.Column="1" Text="{Binding ServerVersion, TargetNullValue='—'}" />
                                <TextBlock Grid.Row="1" Text="Host" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HostText}" />
                                <TextBlock Grid.Row="2" Text="Database" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Database}" />
                                <TextBlock Grid.Row="3" Text="User" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Profile.User}" />
                                <TextBlock Grid.Row="4" Text="TLS" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SslText}" />
                                <TextBlock Grid.Row="5" Text="SSH" Style="{StaticResource MutedText}" Margin="0,2,14,2" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SshText}" />
                                <TextBlock Grid.Row="6" Text="Error" Style="{StaticResource MutedText}" Margin="0,2,14,2"
                                           Visibility="{Binding LastError, Converter={x:Static infra:NullToVisibilityConverter.Instance}}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastError}" Foreground="{DynamicResource c.app.error}" MaxWidth="360"
                                           Visibility="{Binding LastError, Converter={x:Static infra:NullToVisibilityConverter.Instance}}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Edit…" Command="{Binding EditConnectionCommand}" />
                                <Button Content="Reconnect" Margin="8,0,0,0" Command="{Binding ReconnectCommand}"
                                        ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[workspace.reconnect]}" />
                                <Button Content="Disconnect" Margin="8,0,0,0" Command="{Binding DisconnectCommand}"
                                        ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[workspace.disconnect]}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="tb.reload">
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunCommand}" CommandParameter="workspace.reload"
                    ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[workspace.reload]}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="tb.command">
            <Button Style="{StaticResource ToolbarButton}" Command="{Binding RunCommand}" CommandParameter="palette.openAnything"
                    ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[palette.openAnything]}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="tb.panels">
            <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsConsoleVisible, Mode=TwoWay}"
                          ToolTip="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[console.toggle]}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" />
            </ToggleButton>
        </DataTemplate>

        <ContextMenu x:Key="SafeModeMenu">
            <MenuItem Header="Silent" Tag="{x:Static conn:SafeModeLevel.Silent}" Click="OnSafeModeLevelClick" />
            <MenuItem Header="Alert 1 — confirm every query" Tag="{x:Static conn:SafeModeLevel.Alert1}" Click="OnSafeModeLevelClick" />
            <MenuItem Header="Alert 2 — confirm except reads" Tag="{x:Static conn:SafeModeLevel.Alert2}" Click="OnSafeModeLevelClick" />
            <MenuItem Header="Safe 1 — password for every query" Tag="{x:Static conn:SafeModeLevel.Safe1}" Click="OnSafeModeLevelClick" />
            <MenuItem Header="Safe 2 — password except reads" Tag="{x:Static conn:SafeModeLevel.Safe2}" Click="OnSafeModeLevelClick" />
        </ContextMenu>

        <ContextMenu x:Key="TabMenu">
            <MenuItem Header="New Tab" Click="OnTabMenuNew" InputGestureText="{Binding Source={x:Static infra:AppServices.Gestures}, Path=[tab.new]}" />
            <Separator />
            <MenuItem Header="Close" Click="OnTabMenuClose" InputGestureText="{Binding Source={x:Static infra:AppServices.Gestures}, Path=[tab.close]}" />
            <MenuItem Header="Close Others" Click="OnTabMenuCloseOthers" />
            <MenuItem Header="Close to the Right" Click="OnTabMenuCloseRight" />
            <MenuItem Header="Close All" Click="OnTabMenuCloseAll" />
            <Separator />
            <MenuItem Header="Rename Tab…" Click="OnTabMenuRename" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: items built in code from settings.toolbar.items + feature registrations -->
        <Border Background="{DynamicResource c.app.toolbar}" BorderBrush="{DynamicResource c.app.border}" BorderThickness="0,0,0,1"
                Padding="6,5" TextElement.Foreground="{DynamicResource c.app.toolbarForeground}">
            <Grid x:Name="ToolbarPanel" />
        </Border>

        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="0" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="4" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder" Background="{DynamicResource c.app.sidebar}"
                    TextElement.Foreground="{DynamicResource c.app.sidebarForeground}">
                <ContentControl x:Name="SidebarHost" Focusable="False" />
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource c.app.border}" Opacity="0.6" />

            <Grid Grid.Column="2" x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition x:Name="ConsoleSplitterRow" Height="0" />
                    <RowDefinition x:Name="ConsoleRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- Tab strip -->
                <Border Background="{DynamicResource c.app.tab}" BorderBrush="{DynamicResource c.app.border}" BorderThickness="0,0,0,1">
                    <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="OnTabStripWheel" MinHeight="32">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ContextMenu" Value="{StaticResource TabMenu}" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <EventSetter Event="PreviewMouseDown" Handler="OnTabMouseDown" />
                                <EventSetter Event="MouseDoubleClick" Handler="OnTabDoubleClick" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{DynamicResource c.app.tab}" BorderBrush="{DynamicResource c.app.border}"
                                                    BorderThickness="0,0,1,0" Padding="12,0,4,0" MinWidth="90" MaxWidth="260" Height="32">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Accent" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Margin="-12,0,-4,0"
                                                            Background="{DynamicResource c.app.accent}" Visibility="Collapsed" />
                                                    <TextBlock x:Name="TitleText" Text="{Binding DisplayTitle}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource c.app.tabForeground}" />
                                                    <Grid Grid.Column="1" Width="22" Height="22" Margin="4,0,0,0">
                                                        <TextBlock x:Name="DirtyDot" Text="●" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource c.app.accent}" Visibility="Collapsed" />
                                                        <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Padding="0" MinHeight="0" Width="20" Height="20"
                                                                Command="{Binding DataContext.CloseTabItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}" Opacity="0" ToolTip="Close">
                                                            <TextBlock Style="{StaticResource Icon}" FontSize="9" Text="&#xE8BB;" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                    <Setter TargetName="TitleText" Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter TargetName="DirtyDot" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                    <Setter TargetName="DirtyDot" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c.app.tabHover}" />
                                                    <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                                                    <Setter TargetName="DirtyDot" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c.app.tabActive}" />
                                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource c.app.tabActiveForeground}" />
                                                    <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- Active tab content -->
                <ws:TabHost x:Name="Host" Grid.Row="1" Tabs="{Binding Tabs}" ActiveTab="{Binding ActiveTab}" />
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="24"
                           Style="{StaticResource MutedText}"
                           Visibility="{Binding HasTabs, Converter={x:Static infra:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                    <Run Text="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[editor.new], Mode=OneWay}" /><LineBreak />
                    <Run Text="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[palette.openAnything], Mode=OneWay}" /><LineBreak />
                    <Run Text="{Binding Source={x:Static infra:AppServices.Shortcuts}, Path=[palette.openDatabase], Mode=OneWay}" />
                </TextBlock>

                <!-- Bottom console slot -->
                <GridSplitter x:Name="ConsoleSplitter" Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource c.app.border}" Opacity="0.6" />
                <Border Grid.Row="3" x:Name="ConsoleBorder" Background="{DynamicResource c.app.window}">
                    <ContentControl x:Name="ConsoleHost" Focusable="False" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
