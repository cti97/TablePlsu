<UserControl x:Class="TablePlsu.App.Features.Results.ResultGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:TablePlsu.App.Infrastructure"
             infra:CommandScopes.Scope="Grid"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ResultCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource c.grid.foreground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource c.grid.cellSelectionBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource c.grid.foreground}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource c.grid.cellSelectionBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource c.grid.headerBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource c.grid.headerForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource c.grid.lines}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,3,6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <TextBlock x:Name="SortGlyph" DockPanel.Dock="Right" Margin="4,0,0,0" FontSize="9"
                                               VerticalAlignment="Center" Visibility="Collapsed" Text="▲" />
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="4" Cursor="SizeWE" Opacity="0" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Cursor="SizeWE" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SortGlyph" Property="Text" Value="▲" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SortGlyph" Property="Text" Value="▼" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultRowHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="{DynamicResource c.grid.headerBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource c.grid.headerForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource c.grid.lines}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DataGrid x:Name="InnerGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeRows="False"
              CanUserReorderColumns="True"
              CanUserSortColumns="True"
              IsReadOnly="True"
              SelectionUnit="CellOrRowHeader"
              SelectionMode="Extended"
              HeadersVisibility="All"
              GridLinesVisibility="All"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Item"
              VirtualizingPanel.CacheLengthUnit="Item"
              VirtualizingPanel.CacheLength="4,4"
              ScrollViewer.IsDeferredScrollingEnabled="False"
              ScrollViewer.CanContentScroll="True"
              AlternationCount="2"
              FontFamily="{DynamicResource grid.fontFamily}"
              FontSize="{DynamicResource grid.fontSize}"
              RowHeight="{DynamicResource grid.rowHeight}"
              Background="{DynamicResource c.grid.background}"
              Foreground="{DynamicResource c.grid.foreground}"
              RowBackground="{DynamicResource c.grid.background}"
              AlternatingRowBackground="{DynamicResource c.grid.altRowBackground}"
              HorizontalGridLinesBrush="{DynamicResource c.grid.lines}"
              VerticalGridLinesBrush="{DynamicResource c.grid.lines}"
              BorderBrush="{DynamicResource c.grid.lines}"
              BorderThickness="0"
              CellStyle="{StaticResource ResultCellStyle}"
              ColumnHeaderStyle="{StaticResource ResultColumnHeaderStyle}"
              RowHeaderStyle="{StaticResource ResultRowHeaderStyle}"
              RowHeaderWidth="32" />
</UserControl>
