<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TablePlsu.App</RootNamespace>
    <AssemblyName>TablePlsu.App</AssemblyName>
    <Product>TablePlsu</Product>
    <AssemblyTitle>TablePlsu</AssemblyTitle>
    <Description>A fast PostgreSQL client for Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs the single-instance check before WPF loads (the generated App.Main is not used). -->
    <StartupObject>TablePlsu.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Speed rules (architecture §Speed rules 2). The RID is supplied on publish: -r win-x64. scripts/publish.ps1 publishes
       self-contained with PublishReadyToRunComposite (runtime + WPF + app in one composite R2R image), which cuts startup
       JIT from ~1,700 to ~560 methods; -FrameworkDependent gives the small per-assembly R2R build. -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- Touch/pen through the WM_POINTER stack instead of WISP: WISP enumerates tablets on a pen thread inside the first
       Window.Show (35-100 ms of waiting); the pointer stack reads the device list directly. Mouse and keyboard input
       are unchanged; touch and pen keep working (Windows 8+). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TablePlsu.Core\TablePlsu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TablePlsu.App.Tests" />
  </ItemGroup>

</Project>
