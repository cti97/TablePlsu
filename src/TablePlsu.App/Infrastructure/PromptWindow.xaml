<Window x:Class="TablePlsu.App.Infrastructure.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MinHeight="120"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource c.app.window}" Foreground="{DynamicResource c.app.windowForeground}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" Grid.Row="1" Visibility="Collapsed" MinHeight="26" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="1" Visibility="Collapsed" MinHeight="26" />
        <TextBox x:Name="DetailBox" Grid.Row="2" Visibility="Collapsed" IsReadOnly="True" MaxHeight="260" Margin="0,4,0,0"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" IsDefault="True" MinWidth="84" Style="{DynamicResource AccentButton}" Click="OnOk" />
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="84" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
