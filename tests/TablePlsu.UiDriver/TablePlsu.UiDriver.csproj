<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process UI Automation driver for end-to-end tests of the real app. UI Automation runs here, never inside the
       test host: a UIA client in the test host slows its own WPF UI tests to a crawl. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
