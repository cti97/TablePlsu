<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end UI flows: drives the published TablePlsu.App.exe with real keystrokes (SendInput) and UI Automation.
       Not an xUnit project on purpose (it needs an interactive desktop and the test DB); run scripts/ui-flows.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
